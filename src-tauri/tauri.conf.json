{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "课程表",
  "version": "0.1.0",
  "identifier": "com.timetable.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "课程表",
        "width": 1100,
        "height": 600,
        "minWidth": 700,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
